# Node.js 24+; build on a local machine, run the artifacts on the server.
HOST=127.0.0.1
PORT=8788
DATA_DIR=./data
PUBLIC_ORIGIN=https://visora.ritel.si
# Legacy gateway mode only: comma-separated HTTPS origins. Central account mode requires the exact selected consumer origins.
PUBLIC_ORIGINS=
# Sub2API website/API origin; do not append /v1. Supply your own trusted gateway.
GATEWAY_BASE_URL=https://gateway.example.com
IMAGE_MODEL=gpt-image-2.5
CHAT_MODEL=gpt-6-luna
# Models offered in the conversation selector; upstream group permissions still apply.
CHAT_MODELS=gpt-6-luna,gpt-6.1-sol
JOB_CONCURRENCY=10
# Local demonstration only; leave 0 for every public deployment.
DEMO_MODE=0
# Password login works independently. SSO also needs the gateway-side bridge.
SSO_ENABLED=0
SSO_SOURCES=[{"id":"main","name":"我的中转","origin":"https://gateway.example.com"}]

# Visora cutover: two isolated consumers, ONE business process/store/queue.
# SUB2API_ACCOUNT_CONFIG=/app/account-state/visora.config.json
# LEGACY_SUB2API_ACCOUNT_CONFIG=/app/account-state/config.json
# PUBLIC_ORIGIN=https://visora.ritel.si
# PUBLIC_ORIGINS=https://visora.ritel.si,https://images.ritel.si
# Legacy config retains its existing origin/clientId/secret/stateFile.
