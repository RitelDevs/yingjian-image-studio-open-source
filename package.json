{
  "name": "ritelt-image-studio",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "build": "node scripts/build.mjs",
    "package": "pwsh -NoProfile -File scripts/package.ps1",
    "check": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:published": "node scripts/build.mjs --published-homepage",
    "release:package": "node scripts/package-release.mjs",
    "check:editor-ui": "node scripts/check-editor-workspace.mjs --build"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.25.0",
    "vite": "^7.2.7",
    "playwright": "1.59.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
