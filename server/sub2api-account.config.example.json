{
  "version": 1,
  "origin": "https://visora.ritel.si",
  "issuer": "https://account.example.invalid",
  "clientId": "visora",
  "clientSecretFile": "visora-client-secret",
  "stateFile": "visora-consumer.sqlite",
  "runtimeRoot": "/opt/ritel-account",
  "transport": "loopback-proxy",
  "trustedProxyIPs": [
    "127.0.0.1",
    "::1"
  ],
  "oidc": {
    "authorizationEndpoint": "https://account.example.invalid/auth",
    "tokenEndpoint": "https://account.example.invalid/token",
    "jwksURI": "https://account.example.invalid/jwks"
  }
}
