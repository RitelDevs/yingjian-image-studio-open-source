# Put this private .env beside compose.example.yaml on the deployment host.
PORT=8793
PUBLIC_ORIGIN=https://visora.ritel.si
GATEWAY_BASE_URL=http://127.0.0.1:8081
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_MODELS=gpt-image-2.5-flare,gpt-image-2.5-sunburst,gpt-image-2.6-flare,gpt-image-2.6-sunburst
CHAT_MODEL=gpt-6-luna
JOB_CONCURRENCY=10
SSO_ENABLED=0
SSO_SOURCES=[{"id":"main","name":"我的中转","origin":"https://gateway.example.com"}]

# New-origin central account mode; requires the reviewed runtime and private mount.
# SUB2API_ACCOUNT_CONFIG=/app/account-state/config.json
# PUBLIC_ORIGIN=https://visora.ritel.si
# PUBLIC_ORIGINS=https://visora.ritel.si
# SSO_ENABLED=0

# Visora cutover: two isolated consumers, ONE business process/store/queue.
# SUB2API_ACCOUNT_CONFIG=/app/account-state/visora.config.json
# LEGACY_SUB2API_ACCOUNT_CONFIG=/app/account-state/config.json
# PUBLIC_ORIGIN=https://visora.ritel.si
# PUBLIC_ORIGINS=https://visora.ritel.si,https://images.ritel.si
# Legacy config retains its existing origin/clientId/secret/stateFile.

# Optional reference library (prepare assets before enabling):
# REFERENCE_LIBRARY_ROOT=/app/reference-library
